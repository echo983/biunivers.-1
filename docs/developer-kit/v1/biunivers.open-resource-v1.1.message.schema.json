{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "biunivers.open-resource-v1.1.message.schema.json",
  "title": "Biunivers Open Resource Protocol v1.1 openMany request",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "requestId", "method", "params"],
  "properties": {
    "protocol": {
      "const": "biunivers.resource-session/1"
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "method": {
      "const": "resource.openMany"
    },
    "params": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "access": {
          "const": "read"
        },
        "maximum": {
          "type": "integer",
          "minimum": 2,
          "maximum": 500
        }
      }
    }
  }
}
