{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "biunivers.app.schema.json",
  "title": "Biunivers App Manifest v1",
  "description": "Manifest for a Biunivers Static App Protocol v1 application.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "protocol",
    "appId",
    "version",
    "name",
    "license",
    "icon",
    "window",
    "configuration"
  ],
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "protocol": {
      "const": "biunivers.static-app/1"
    },
    "appId": {
      "type": "string",
      "pattern": "^io\\.github\\.[a-z0-9-]+\\.[a-z0-9.-]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "maxLength": 300
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "icon": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*\\\\).+$"
    },
    "window": {
      "$ref": "#/definitions/window"
    },
    "configuration": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/configurationItem"
      }
    }
  },
  "definitions": {
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "defaultWidth",
        "defaultHeight"
      ],
      "properties": {
        "defaultWidth": {
          "type": "integer",
          "minimum": 1
        },
        "defaultHeight": {
          "type": "integer",
          "minimum": 1
        },
        "minWidth": {
          "type": "integer",
          "minimum": 1
        },
        "minHeight": {
          "type": "integer",
          "minimum": 1
        },
        "desktop": {
          "type": "boolean",
          "default": true
        },
        "pinned": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "configurationItem": {
      "oneOf": [
        {
          "$ref": "#/definitions/stringConfiguration"
        },
        {
          "$ref": "#/definitions/booleanConfiguration"
        },
        {
          "$ref": "#/definitions/integerConfiguration"
        },
        {
          "$ref": "#/definitions/numberConfiguration"
        },
        {
          "$ref": "#/definitions/selectConfiguration"
        }
      ]
    },
    "configurationBase": {
      "type": "object",
      "required": [
        "key",
        "label",
        "type",
        "required"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][A-Za-z0-9]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "maxLength": 300
        },
        "type": {
          "enum": [
            "string",
            "boolean",
            "integer",
            "number",
            "select"
          ]
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "stringConfiguration": {
      "allOf": [
        {
          "$ref": "#/definitions/configurationBase"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "key",
            "label",
            "type",
            "required"
          ],
          "properties": {
            "key": {
              "type": "string",
              "pattern": "^[a-z][A-Za-z0-9]*$"
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string",
              "maxLength": 300
            },
            "type": {
              "const": "string"
            },
            "required": {
              "type": "boolean"
            },
            "default": {
              "type": "string"
            }
          }
        }
      ]
    },
    "booleanConfiguration": {
      "allOf": [
        {
          "$ref": "#/definitions/configurationBase"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "key",
            "label",
            "type",
            "required"
          ],
          "properties": {
            "key": {
              "type": "string",
              "pattern": "^[a-z][A-Za-z0-9]*$"
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string",
              "maxLength": 300
            },
            "type": {
              "const": "boolean"
            },
            "required": {
              "type": "boolean"
            },
            "default": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "integerConfiguration": {
      "allOf": [
        {
          "$ref": "#/definitions/configurationBase"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "key",
            "label",
            "type",
            "required"
          ],
          "properties": {
            "key": {
              "type": "string",
              "pattern": "^[a-z][A-Za-z0-9]*$"
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string",
              "maxLength": 300
            },
            "type": {
              "const": "integer"
            },
            "required": {
              "type": "boolean"
            },
            "default": {
              "type": "integer"
            },
            "minimum": {
              "type": "integer"
            },
            "maximum": {
              "type": "integer"
            }
          }
        }
      ]
    },
    "numberConfiguration": {
      "allOf": [
        {
          "$ref": "#/definitions/configurationBase"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "key",
            "label",
            "type",
            "required"
          ],
          "properties": {
            "key": {
              "type": "string",
              "pattern": "^[a-z][A-Za-z0-9]*$"
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string",
              "maxLength": 300
            },
            "type": {
              "const": "number"
            },
            "required": {
              "type": "boolean"
            },
            "default": {
              "type": "number"
            },
            "minimum": {
              "type": "number"
            },
            "maximum": {
              "type": "number"
            }
          }
        }
      ]
    },
    "selectConfiguration": {
      "allOf": [
        {
          "$ref": "#/definitions/configurationBase"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "key",
            "label",
            "type",
            "required",
            "options"
          ],
          "properties": {
            "key": {
              "type": "string",
              "pattern": "^[a-z][A-Za-z0-9]*$"
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string",
              "maxLength": 300
            },
            "type": {
              "const": "select"
            },
            "required": {
              "type": "boolean"
            },
            "default": {
              "type": "string"
            },
            "options": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    }
  }
}
