{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "biunivers.resource-session.message.schema.json",
  "title": "Biunivers Resource Session Protocol v1 request",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "requestId", "method", "params"],
  "properties": {
    "protocol": {
      "const": "biunivers.resource-session/1"
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "method": {
      "enum": [
        "resource.getCapabilities",
        "resource.claimLaunch",
        "resource.open",
        "resource.saveAs",
        "resource.getMetadata",
        "resource.renew",
        "resource.release"
      ]
    },
    "params": {
      "type": "object"
    }
  }
}
