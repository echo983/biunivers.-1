[Unit]
Description=Biunivers Host
Requires=biunivers-runtime.service
After=biunivers-runtime.service

[Service]
Type=simple
User=biunivers
Group=biunivers
SupplementaryGroups=docker
EnvironmentFile=/etc/biunivers/biunivers.env
ExecStart=/opt/biunivers/current/deploy/bin/biunivers-host
ExecStop=-/usr/bin/docker stop --time 20 biunivers-host
Restart=on-failure
RestartSec=5s
TimeoutStartSec=90s
TimeoutStopSec=30s
UMask=0077
NoNewPrivileges=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
