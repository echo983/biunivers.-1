# Public origins must be different. Production deployments normally put both
# behind an authenticated HTTPS reverse proxy with wildcard app DNS.
BIUNIVERS_DESKTOP_ORIGIN=http://localhost:8080
BIUNIVERS_APP_ORIGIN=http://localhost:8081
BIUNIVERS_DESKTOP_PORT=8080
BIUNIVERS_APP_PORT=8081
BIUNIVERS_DESKTOP_BIND=127.0.0.1
BIUNIVERS_APP_BIND=127.0.0.1

BIUNIVERS_FILE_ENABLED=true
BIUNIVERS_FILE_INITIALIZE=false
BIUNIVERS_FILE_S3_ENDPOINT=https://replace-me.example.com
BIUNIVERS_FILE_S3_REGION=auto
BIUNIVERS_FILE_S3_BUCKET=replace-me
BIUNIVERS_FILE_S3_PREFIX=biunivers-files
BIUNIVERS_FILE_NAMESPACE=replace-with-a-stable-private-namespace
BIUNIVERS_FILE_S3_ACCESS_KEY_ID=replace-me
BIUNIVERS_FILE_S3_SECRET_ACCESS_KEY=replace-me
BIUNIVERS_FILE_S3_FORCE_PATH_STYLE=true

BIUNIVERS_BWA_ENABLED=true
